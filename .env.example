# Copy to .env and adjust. Every value here is optional except HF_TOKEN
# (needed once, to download the speaker-diarization model).

# --- Speaker diarization (pyannote) ---------------------------------------
# 1. Create a free account at https://huggingface.co
# 2. Accept the conditions at https://hf.co/pyannote/speaker-diarization-community-1
# 3. Create a read token at https://hf.co/settings/tokens and paste it here.
# After the first successful start the model is cached in the "models" volume
# and the token is no longer needed.
HF_TOKEN=
DIARIZE=true
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# --- Speech-to-text (Whisper) ----------------------------------------------
# Engine: auto = faster-whisper on CPU/NVIDIA, whisper.cpp on Vulkan/Metal.
# See docs/how-to/vulkan.md and docs/how-to/metal.md.
SPEECH_ENGINE=auto
# tiny | base | small | medium | large-v3 | large-v3-turbo (best speed/accuracy)
WHISPER_MODEL=large-v3-turbo
# Leave empty to auto-detect per file, or force e.g. "en", "de", "zh".
DEFAULT_LANGUAGE=
# faster-whisper only. auto = float16 on GPU, int8 on CPU
WHISPER_COMPUTE_TYPE=auto
# 0 = auto (8 on GPU, 1 on CPU). Higher is faster but uses more memory.
WHISPER_BATCH_SIZE=0
# CPU threads per worker for inference, 0 = all cores.
CPU_THREADS=0

# --- Outputs ---------------------------------------------------------------
# Formats written to data/output for every file: md, txt, json, srt, vtt
OUTPUT_FORMATS=md
# true: move finished originals to data/archive. false: delete them.
ARCHIVE_ORIGINALS=true

# --- Queue -----------------------------------------------------------------
MAX_ATTEMPTS=3
# A job whose worker stops heart-beating for this long is re-queued.
LEASE_SECONDS=120
# A file in the inbox must be unchanged this long before it is picked up.
STABLE_SECONDS=5

# --- Web UI / API ----------------------------------------------------------
# Only reachable from this machine by default. Use 0.0.0.0 to expose on the
# network (there is no authentication, so only do that on a trusted network).
BIND_ADDR=127.0.0.1
PORT=8090
# Host folder that holds inbox/, output/, archive/ and failed/.
DATA_DIR=./data
